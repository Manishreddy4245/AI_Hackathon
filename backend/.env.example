# PlaceMind Environment Template
ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=placemind
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your-high-entropy-jwt-secret-key
SECURITY_SALT=your-high-entropy-security-salt
AI_API_KEY=your_optional_openai_or_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key
ALLOW_MOCK_DB=True
SEED_DEMO_DATA=True
ENABLE_DB_SEED=True
