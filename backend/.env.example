# PlaceMind Development Environment Template
# Copy this file to backend/.env and customize for your local setup
ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=placemind
FRONTEND_URL=http://localhost:5173
JWT_SECRET=REPLACE_WITH_SECURE_SECRET
SECURITY_SALT=REPLACE_WITH_SECURE_SALT
AI_API_KEY=REPLACE_WITH_AI_API_KEY
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
ALLOW_MOCK_DB=False
SEED_DEMO_DATA=False
ENABLE_DB_SEED=False
