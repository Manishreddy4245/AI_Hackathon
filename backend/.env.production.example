# Production Environment Profile Template (TEMPLATE ONLY - NO REAL SECRETS)
# For production deployments, inject these variables via secure environment/cloud secret manager.
ENV=production
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_domain>/<database_name>?retryWrites=true&w=majority
MONGODB_DATABASE=placemind_prod
FRONTEND_URL=https://your-production-domain.com
JWT_SECRET=REPLACE_WITH_SECURE_64_CHAR_RANDOM_SECRET_KEY
SECURITY_SALT=REPLACE_WITH_SECURE_64_CHAR_RANDOM_SALT_KEY
AI_API_KEY=REPLACE_WITH_PRODUCTION_AI_API_KEY
GEMINI_API_KEY=REPLACE_WITH_PRODUCTION_GEMINI_API_KEY
ALLOW_MOCK_DB=False
SEED_DEMO_DATA=False
ENABLE_DB_SEED=False
